# Copy to backend/.env.local and fill in. .env.local is gitignored.

# Database (local docker compose default)
DATABASE_URL=postgres://pantry:pantry@localhost:5432/pantry_panel?sslmode=disable

# Google Custom Search (Phase 4 機能I: 商品画像設定)
# 未設定時は GET /api/image-search が 503 を返すが、他の機能は動作する。
# Google Cloud Console で API key を発行し、Programmable Search Engine で CSE ID を取得する。
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
